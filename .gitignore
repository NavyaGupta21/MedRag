# ---------------------------------------------------------------------------
# Corpus data
# ---------------------------------------------------------------------------
# corpus/statpearls and corpus/textbooks are ~5GB and are themselves git
# repositories cloned from Hugging Face. Committing them would either add
# gitlinks pointing at repos a cloner cannot resolve, or 5GB of blobs.
corpus/

# ---------------------------------------------------------------------------
# Generated pipeline artifacts
# ---------------------------------------------------------------------------
# Everything here is reproducible from the seed in medrag_mini/config.py:
#
#     python -c "from medrag_mini.sample import sample_corpus; sample_corpus()"
#     python -c "from medrag_mini.corpus import load_records; \
#                from medrag_mini.config import SAMPLED_CORPUS_PATH; \
#                from medrag_mini.embed import build_index; \
#                build_index(load_records(SAMPLED_CORPUS_PATH))"
#
# sampled_corpus.jsonl, manifest.json, embeddings.npz
artifacts/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
# .venv-eval holds the isolated RAGAS install. It is recreated by
# ./scripts/setup_eval_venv.sh, which pins the versions that actually work.
.venv-eval/
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Testing and type checking
# ---------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
# NOTE: notebooks/*.ipynb are deliberately TRACKED, including their executed
# outputs - the recorded metrics and the calibration plot are part of what the
# walkthrough communicates. Only Jupyter's own scratch state is ignored.
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
.jupyter/
.local/
profile_default/
ipython_config.py

# ---------------------------------------------------------------------------
# Model weights and caches
# ---------------------------------------------------------------------------
# MedCPT and Qwen weights live in the shared Hugging Face cache
# (~/.cache/huggingface), not in the repo. These patterns catch the case where
# a cache is redirected here via HF_HOME or TRANSFORMERS_CACHE.
.cache/
huggingface/
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.gguf

# Embedding and index files anywhere in the tree, not just artifacts/
*.npy
*.npz
*.faiss
*.index

# ---------------------------------------------------------------------------
# Logs, scratch, and local overrides
# ---------------------------------------------------------------------------
*.log
logs/
scratch/
tmp/
.env
.env.local
*.local

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Design documents
# ---------------------------------------------------------------------------
# Kept on disk as a local working record, not tracked in git.
# Contains the design spec, the implementation plan, and the findings notes.
docs/

# ---------------------------------------------------------------------------
# Deliberately TRACKED - listed here so the intent is explicit
# ---------------------------------------------------------------------------
# notebooks/*.ipynb         the walkthrough, with executed outputs
# medrag_mini/, tests/, scripts/
# README-medrag-mini.md, requirements-mini.txt
